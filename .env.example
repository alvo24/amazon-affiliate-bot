# ==========================================
# Amazon Affiliate Bot - environment template
# Copy this file to .env and fill in the values.
# ==========================================

# --- App ---
APP_SECRET=change-me-to-a-long-random-string
APP_ADMIN_PASSWORD=change-me
DATABASE_URL=sqlite:///./data/app.db
LOG_LEVEL=INFO

# Set to "true" to run without real API calls (returns mock products, logs posts instead of publishing).
# Useful until you have all your API keys.
DRY_RUN=true

# --- Amazon Product Advertising API (PA-API 5.0) ---
# Get these from https://affiliate-program.amazon.com (you need 3 qualifying sales in 180 days first).
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
# Marketplace host. Common values:
#   www.amazon.com (US), www.amazon.co.uk, www.amazon.de, www.amazon.ca, www.amazon.in, www.amazon.com.au
AMAZON_HOST=www.amazon.com
# Region matching the host: us-east-1, eu-west-1, us-west-2, eu-central-1, etc.
AMAZON_REGION=us-east-1

# Comma-separated list of BrowseNode IDs (categories) to pull bestsellers from.
# Find IDs at https://www.browsenodes.com. Example US: 172282 (Electronics), 165793011 (Home & Kitchen).
AMAZON_BROWSE_NODES=172282,165793011
# Max products to fetch per run.
AMAZON_MAX_ITEMS=10

# --- Facebook Page (Graph API) ---
# Create a long-lived Page Access Token at https://developers.facebook.com/tools/explorer
# Required permissions: pages_manage_posts, pages_read_engagement
FACEBOOK_PAGE_ID=1249465390424048
FACEBOOK_PAGE_ACCESS_TOKEN=544a598959fafb23a927ac1ea18463c6

# --- Instagram Business (Graph API) ---
# Your IG account must be a Business account linked to a Facebook Page.
# Token needs: instagram_basic, instagram_content_publish, pages_show_list
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# --- Pinterest API v5 ---
# Create an app at https://developers.pinterest.com/apps/ and generate an access token.
# Required scopes: boards:read, pins:read, pins:write
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# --- Scheduling ---
# Cron expression for when to auto-post. Default: every day at 9am, 1pm, 6pm.
POST_SCHEDULE_CRON=0 9,13,18 * * *
# Timezone for the scheduler (IANA name).
TIMEZONE=UTC

# --- Posting options ---
# Caption template. Placeholders: {title}, {price}, {url}, {features}
CAPTION_TEMPLATE=🔥 {title}\n\n💰 {price}\n\n{features}\n\n👉 Shop here: {url}\n\n#amazonfinds #affiliate #shopping
# Platforms to post to (comma-separated): facebook,instagram,pinterest
ENABLED_PLATFORMS=facebook,instagram,pinterest
